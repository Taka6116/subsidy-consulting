// API と同様、外部ソースの欠損を許容する（NOT NULL を乱用しない・rawPayload で後追い可能）。
// https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// jGrants 等から同期する補助金レコード。必須は id のみ。欠損は null。
model SubsidyGrant {
  id                 String   @id @default(cuid())
  externalId         String?  @unique
  name               String?
  maxAmountLabel     String?
  deadlineLabel      String?
  targetIndustryNote String?  @db.Text
  targetUseNote      String?  @db.Text
  rawPayload         Json?
  targetIndustries   String[] @default([])
  description        String?  @db.Text
  syncedAt           DateTime @default(now())
  updatedAt          DateTime @updatedAt // auto-updated by Prisma (DB default is for initial fill)
  syncRunId          String?

  status           String    @default("open")
  source           String    @default("manual")
  subsidyAmount    BigInt?   @map("subsidy_amount")
  subsidyRate      Decimal?  @map("subsidy_rate") @db.Decimal(4, 2)
  deadline         DateTime? @db.Date
  municipalityCode String?   @map("municipality_code")
  officialPageUrl  String?   @map("official_page_url")
  institutionName  String?   @map("institution_name")
  fetchedAt        DateTime? @map("fetched_at")
  contentHash      String?   @map("content_hash")
  /**
   * 対象地域。"全国" / "東京都" / "愛知県" など。jGrants の target_area_search から抽出
   */
  prefecture       String?

  syncRun  SubsidySyncRun?    @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  contents GeneratedContent[]
  jobs     ContentJob[]

  @@index([syncedAt])
  @@index([updatedAt])
  @@index([prefecture])
  @@index([municipalityCode])
  @@index([officialPageUrl])
}

model Municipality {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  prefectureName String    @map("prefecture_name")
  type           String
  officialUrl    String?   @map("official_url")
  subsidyPageUrl String?   @map("subsidy_page_url")
  feedUrl        String?   @map("feed_url")
  crawlStrategy  String    @default("html_list") @map("crawl_strategy")
  crawlConfig    Json?     @map("crawl_config")
  lastCrawledAt  DateTime? @map("last_crawled_at")
  crawlStatus    String    @default("pending") @map("crawl_status")
  errorMessage   String?   @map("error_message")
  priority       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  crawlResults MunicipalityCrawlResult[]

  @@index([prefectureName])
  @@index([crawlStatus])
  @@index([lastCrawledAt])
  @@map("municipalities")
}

model MunicipalityCrawlResult {
  id             String       @id @default(cuid())
  municipalityId String       @map("municipality_id")
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  crawledAt      DateTime     @default(now()) @map("crawled_at")
  linksFound     Int          @default(0) @map("links_found")
  newGrants      Int          @default(0) @map("new_grants")
  updatedGrants  Int          @default(0) @map("updated_grants")
  errors         Json?
  duration       Int?

  @@index([municipalityId])
  @@index([crawledAt])
  @@map("municipality_crawl_results")
}

/// 補助金に紐づく生成コンテンツ（記事 / LP / 台本等）
model GeneratedContent {
  id              String    @id @default(uuid()) @db.Uuid
  subsidyId       String    @map("subsidy_id")
  contentType     String    @map("content_type")
  slug            String?   @unique
  title           String?
  excerpt         String?   @db.Text
  body            String?   @db.Text
  metaDescription String?   @map("meta_description") @db.Text
  tags            String[]  @default([])
  heroImagePath   String?   @map("hero_image_path")
  audioPath       String?   @map("audio_path")
  videoPath       String?   @map("video_path")
  thumbnailPath   String?   @map("thumbnail_path")
  duration        Int?
  status          String    @default("draft")
  publishedAt      DateTime? @map("published_at")
  newsletterSentAt DateTime? @map("newsletter_sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  grant SubsidyGrant @relation(fields: [subsidyId], references: [id], onDelete: Cascade)

  @@index([subsidyId])
  @@index([status, publishedAt])
  @@map("generated_contents")
}

/// コンテンツ生成ジョブ
model ContentJob {
  id          String    @id @default(uuid()) @db.Uuid
  subsidyId   String    @map("subsidy_id")
  jobType     String    @map("job_type")
  status      String    @default("pending")
  triggeredAt DateTime  @default(now()) @map("triggered_at")
  completedAt DateTime? @map("completed_at")

  grant SubsidyGrant @relation(fields: [subsidyId], references: [id], onDelete: Cascade)

  @@unique([subsidyId, jobType])
  @@index([subsidyId])
  @@map("content_jobs")
}

/// 同期・取り込みのサマリログ（任意）
model SyncLog {
  id              String   @id @default(uuid()) @db.Uuid
  syncedAt        DateTime @default(now()) @map("synced_at")
  recordsFetched  Int?     @map("records_fetched")
  recordsUpserted Int?     @map("records_upserted")
  errorMessage    String?  @map("error_message") @db.Text

  @@map("sync_logs")
}

/// 静的マスタ（LP 等で参照）。既存テーブルを保持するためモデル化。
model StaticSubsidy {
  id                      String    @id @db.VarChar(100)
  title                   String    @db.Text
  summary                 String    @db.Text
  subsidyMaxLimit         BigInt?   @map("subsidy_max_limit")
  subsidyRate             String?   @map("subsidy_rate") @db.VarChar(50)
  targetAreaSearch        String?   @map("target_area_search") @db.Text
  targetNumberOfEmployees String?   @map("target_number_of_employees") @db.Text
  acceptanceStatus        String?   @map("acceptance_status") @db.VarChar(100)
  acceptanceEndDatetime   DateTime? @map("acceptance_end_datetime")
  targetThemes            String[]  @default([]) @map("target_themes")
  excludedIndustries      String[]  @default([]) @map("excluded_industries")
  officialUrl             String?   @map("official_url") @db.Text
  institutionName         String?   @map("institution_name") @db.Text
  isActive                Boolean?  @map("is_active")
  createdAt               DateTime? @map("created_at")
  updatedAt               DateTime? @map("updated_at")

  @@map("static_subsidies")
}

/// メールマガジン購読者（補助金速報メール登録）
model Subscriber {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  source         String?   @db.VarChar(100) // "article-cta" / "lp-subscribe" / "exit-intent" など
  subsidyId      String?   @map("subsidy_id") @db.VarChar(100) // 紐づく補助金ID（任意）
  unsubscribeToken String    @unique @map("unsubscribe_token") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  unsubscribedAt   DateTime? @map("unsubscribed_at")

  @@index([email])
  @@index([unsubscribedAt])
  @@map("subscribers")
}

/// 補助金LP からの無料相談申込
model ContactInquiry {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  email     String   @db.VarChar(200)
  company   String?  @db.VarChar(200)
  message   String   @db.Text
  source    String?  @db.VarChar(200) // どのLPから来たか（例: "construction-electrification"）
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@map("contact_inquiries")
}

/// 同期ジョブの実行単位（部分成功も status で表現可能）。
model SubsidySyncRun {
  id           String    @id @default(cuid())
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String
  itemCount    Int?
  errorMessage String?   @db.Text

  grants SubsidyGrant[]
}
