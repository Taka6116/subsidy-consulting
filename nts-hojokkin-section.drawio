    <mxCell id="case2_result_nts" value="課題から整理&#xa;&lt;b&gt;&lt;font style=&quot;font-size:16px;&quot; color=&quot;#2b6cb0&quot;&gt;〜500万円&lt;/font&gt;&lt;/b&gt;&#xa;&lt;font color=&quot;#a0aec0&quot; style=&quot;font-size:9px;&quot;&gt;活用余地が広がる場合があります&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF4FF;strokeColor=#c3daf5;fontColor=#2d3748;fontSize=11;align=center;" vertex="1" parent="1">
      <mxGeometry x="920" y="488" width="180" height="80" as="geometry"/>
