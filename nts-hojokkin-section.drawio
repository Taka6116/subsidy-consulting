    <mxCell id="disclaimer" value="※ 上記はあくまで活用余地のイメージです。申請要件・審査結果により補助額は異なります。" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#a0aec0;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="592" width="1180" height="24" as="geometry"/>
    </mxCell>

    <mxCell id="insight_bg" value="" style="rounded=1;fillColor=#ffffff;strokeColor=#e8edf4;" vertex="1" parent="1">
      <mxGeometry x="40" y="626" width="1180" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="insight_text" value="&lt;b&gt;NTSにご相談いただく場合の進め方&lt;/b&gt;&#xa;&#xa;まず経営上の困りごとをお聞きし、その課題の背景を整理するところから始めます。補助金の選定は課題整理の結果として行うため、当初は想定していなかった制度が選択肢に入ることもあります。補助金活用と経営課題の整理をあわせてご相談いただけます。" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#2d3748;fontSize=12;spacingLeft=16;spacingTop=12;" vertex="1" parent="1">
      <mxGeometry x="56" y="626" width="1148" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="cta_bg" value="" style="rounded=1;fillColor=#1a5fa8;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="40" y="730" width="1180" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="cta_text" value="&lt;b&gt;&lt;font color=&quot;#ffffff&quot; style=&quot;font-size:16px;&quot;&gt;どんな補助金が使えるか、まず話してみませんか&lt;/font&gt;&lt;/b&gt;&#xa;&lt;font color=&quot;#ffffff&quot; style=&quot;font-size:12px;&quot;&gt;申請を前提とせず、情報収集だけのご相談も歓迎しています。&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacingLeft=32;" vertex="1" parent="1">
      <mxGeometry x="40" y="730" width="960" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="cta_btn" value="&lt;b&gt;無料相談を申し込む&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=none;fontColor=#1a5fa8;html=1;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
