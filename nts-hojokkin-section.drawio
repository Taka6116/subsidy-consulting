    <mxCell id="case1_tag" value="卸売業の例" style="rounded=1;fillColor=#EBF4FF;strokeColor=none;fontColor=#4a7fb5;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="52" y="174" width="80" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="case1_problem" value="&lt;b&gt;在庫管理がエクセル依存で、&#xa;部門間の連携がとれていない&lt;/b&gt;&#xa;&#xa;手入力・転記が中心で、過剰在庫や&#xa;納期ずれが繰り返し発生している状況。" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#2d3748;fontSize=12;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="52" y="200" width="186" height="148" as="geometry"/>
    </mxCell>

    <mxCell id="case1_std" value="&lt;b&gt;IT導入補助金&lt;/b&gt;&#xa;&#xa;在庫管理システムの導入費用として申請。&#xa;ツール導入が目的になりやすい。&#xa;&#xa;&lt;font color=&quot;#a0aec0&quot;&gt;対象：ソフトウェア導入費用&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#e2e8f0;fontColor=#2d3748;fontSize=12;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="270" y="170" width="280" height="185" as="geometry"/>
    </mxCell>
    <mxCell id="case1_nts" value="&lt;b&gt;省力化補助金＋IT導入補助金&lt;/b&gt;&#xa;&#xa;根本にある人員不足・属人化という課題を整理すると、&#xa;省力化を目的とした補助金との併用が&#xa;視野に入る場合があります。&#xa;&#xa;&lt;font color=&quot;#4a7fb5&quot;&gt;対象：業務自動化設備＋ソフトウェア&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f6ff;strokeColor=#c3daf5;fontColor=#2d3748;fontSize=12;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="590" y="170" width="300" height="185" as="geometry"/>
    </mxCell>

    <mxCell id="case1_result_std" value="制度単体&#xa;&lt;b&gt;&lt;font style=&quot;font-size:16px;&quot; color=&quot;#718096&quot;&gt;〜100万円&lt;/font&gt;&lt;/b&gt;&#xa;&lt;font color=&quot;#a0aec0&quot; style=&quot;font-size:9px;&quot;&gt;規模・条件により異なります&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#e2e8f0;fontColor=#718096;fontSize=11;align=center;" vertex="1" parent="1">
      <mxGeometry x="920" y="170" width="180" height="80" as="geometry"/>
    </mxCell>
