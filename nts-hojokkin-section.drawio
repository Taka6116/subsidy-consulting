    <mxCell id="eyebrow" value="補助金活用の考え方" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#4a7fb5;fontSize=11;fontStyle=1;" vertex="1" parent="1">
