      <mxGeometry x="40" y="48" width="1240" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="subtitle" value="同じ課題でも、どの視点から整理するかによって、活用できる補助金の選択肢は変わることがあります。" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#718096;fontSize=12;" vertex="1" parent="1">
