    <mxCell id="case2_bg" value="" style="rounded=1;fillColor=#ffffff;strokeColor=#e8edf4;" vertex="1" parent="1">
      <mxGeometry x="40" y="382" width="1180" height="200" as="geometry"/>
    </mxCell>
