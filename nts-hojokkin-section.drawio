    </mxCell>
    <mxCell id="case2_tag" value="製造業の例" style="rounded=1;fillColor=#EBF4FF;strokeColor=none;fontColor=#4a7fb5;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="52" y="394" width="80" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="case2_problem" value="&lt;b&gt;熟練工の引退が相次ぎ、&#xa;生産ラインの維持が難しくなっている&lt;/b&gt;&#xa;&#xa;技術伝承が追いつかず、受注に対して&#xa;人員が確保できない状態が続いている。" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#2d3748;fontSize=12;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="52" y="420" width="186" height="148" as="geometry"/>
    </mxCell>

    <mxCell id="case2_std" value="&lt;b&gt;雇用関係助成金&lt;/b&gt;&#xa;&#xa;採用・育成の文脈で申請。&#xa;人を増やす方向での対応が中心になりやすい。&#xa;&#xa;&lt;font color=&quot;#a0aec0&quot;&gt;対象：採用・訓練費用&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#e2e8f0;fontColor=#2d3748;fontSize=12;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="270" y="390" width="280" height="185" as="geometry"/>
    </mxCell>
    <mxCell id="case2_nts" value="&lt;b&gt;ものづくり補助金＋省力化補助金&lt;/b&gt;&#xa;&#xa;「人に頼る体制」そのものを変えるという方向から&#xa;整理すると、設備投資系の補助金が&#xa;選択肢として浮かび上がることがあります。&#xa;&#xa;&lt;font color=&quot;#4a7fb5&quot;&gt;対象：自動化設備・生産プロセス改善&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f6ff;strokeColor=#c3daf5;fontColor=#2d3748;fontSize=12;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="590" y="390" width="300" height="185" as="geometry"/>
    </mxCell>

    <mxCell id="case2_result_std" value="制度単体&#xa;&lt;b&gt;&lt;font style=&quot;font-size:16px;&quot; color=&quot;#718096&quot;&gt;〜50万円&lt;/font&gt;&lt;/b&gt;&#xa;&lt;font color=&quot;#a0aec0&quot; style=&quot;font-size:9px;&quot;&gt;規模・条件により異なります&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#e2e8f0;fontColor=#718096;fontSize=11;align=center;" vertex="1" parent="1">
      <mxGeometry x="920" y="390" width="180" height="80" as="geometry"/>
